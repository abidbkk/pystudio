rules_version = '2';

// Each student can read and write only their own files: users/{their uid}/files/*
// Only verified Google accounts from the school domain (or a subdomain) are allowed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSchoolUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@([a-z0-9-]+[.])*ics[.]edu[.]jo$');
    }

    function isOwner(uid) {
      return isSchoolUser() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /files/{fileId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.code is string
          && request.resource.data.code.size() <= 200000
          && request.resource.data.bps is list;
      }
    }
  }
}
